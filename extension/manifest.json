{
  "manifest_version": 3,
  "name": "Feed Builder Picker",
  "version": "1.0",
  "permissions": ["scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
       "exclude_matches": [
        "http://localhost:3000/*"
      ],
      "js": ["content.js"]
    }
  ]
}